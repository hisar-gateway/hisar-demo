# Hisar API Gateway — free edition demo configuration
# Shipped as `.env` next to docker-compose.demo.yml. Docker Compose reads it for
# ${…} substitution and the gateway container reads it as its environment.
#
# Passwords below only protect containers on this machine's private compose
# network (Redis and SurrealDB publish no host ports). Change them anyway if the
# stack will live longer than an evaluation.

# Image tag to run (a release tag such as v1.0.57, or latest).
HISAR_VERSION=latest
TZ=Europe/Istanbul

# Host ports. Change them if 8080 or 3000 is already taken on this machine,
# then run `docker compose up -d` again.
# Admin console:
HISAR_UI_PORT=8080
# Gateway (your API traffic):
HISAR_GATEWAY_PORT=3000

# ─── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=apigateway
BACK_END_APP_URL=0.0.0.0:3000
# Origin of the admin console (CORS). The console reaches the API on the same
# origin (/api), so this only matters if you open the API from elsewhere — keep
# its port in step with HISAR_UI_PORT if you do.
FRONT_END_APP_URL=http://localhost:8080
TRUSTED_PROXIES=
TOKIO_WORKER_THREADS=4

# First boot seeds one admin user with this e-mail. The password is generated
# once and printed to the gateway log:
#   docker compose logs apigateway | grep "INITIAL ADMIN CREATED"
BOOTSTRAP_ADMIN_EMAIL=demo@hisar-gateway.com
# BOOTSTRAP_ADMIN_PASSWORD=choose-one-or-leave-unset-for-a-random-password
# Encrypts upstream / identity-provider secrets at rest in SurrealDB. Shipped
# with a fixed demo key — generate your own for anything beyond an evaluation:
#   openssl rand -base64 32
SERVICE_ENC_KEY=GAV+VcNmm8boLoTlOU6qKOhuuE1gX1m6wdU24WsR3eY=

# ─── SurrealDB (config store) ───────────────────────────────────────────────────
DATABASE_URL=surrealdb:8000
DATABASE_USER=root
DATABASE_PASSWORD=hisar-demo-db
DATABASE_NAMESPACE=apigateway
DATABASE_NAME=apigateway_db
DATABASE_HEALTH_CHECK_INTERVAL_SECS=30
DATABASE_CONNECTION_TIMEOUT_SECS=30
DATABASE_MAX_RETRIES=3
SURREALDB_POOL_SIZE=4

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=hisar-demo-redis
REDIS_URL=redis://default:hisar-demo-redis@redis:6379/0
REDIS_DATABASE=0
REDIS_POOL_MAX_OPEN=64
REDIS_MUX_CONNECTIONS=4
REDIS_CONNECTION_TIMEOUT_SECONDS=10
REDIS_POOL_TIMEOUT_SECONDS=60
REDIS_HEALTH_MONITOR_INTERVAL_SECONDS=60
REDIS_CREATE_TIMEOUT_SECONDS=10
REDIS_RYCLE_TIMEOUT_SECONDS=60

# ─── JWT ────────────────────────────────────────────────────────────────────────
# RS256 key pair is generated per process when the *_KEY_PATH vars are unset:
# every container restart invalidates sessions (you sign in again). Mount a PEM
# pair and set the two paths to keep sessions across restarts.
JWT_SECRET=unused-tokens-are-rs256
JWT_ISSUER=apigateway
JWT_AUDIENCE=apigateway-clients
JWT_KEY_ID=hisar-demo
# JWT_PRIVATE_KEY_PATH=/secrets/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/secrets/jwt_public.pem
# The console is served over plain HTTP here, so the refresh cookie cannot be
# marked Secure. Set true behind HTTPS.
AUTH_COOKIE_SECURE=false

# ─── Logging / Elasticsearch ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_TARGET=elasticsearch
LOG_FORMAT=
ELASTIC_URL=http://elasticsearch:9200
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
SERVICE_NAME=apigateway
SERVICE_VERSION=demo
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── SMTP (optional — password reset, licence reminders) ───────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Upstream client / refresh cadence ──────────────────────────────────────────
TOKEN_REFRESH_MIN=900
ROUTE_REFRESH_INTERVAL_SECS=60
HTTP_CLIENT_CONNECT_TIMEOUT_SECS=10
HTTP_CLIENT_POOL_IDLE_TIMEOUT_SECS=90
HTTP_CLIENT_MAX_IDLE_PER_HOST=1024
HTTP_CLIENT_KEEPALIVE_SECS=60
HEALTH_CHECK_INTERVAL_SECS=30
HEALTH_CHECK_TIMEOUT_SECS=5
HEALTH_CHECK_FAILURE_THRESHOLD=3
HEALTH_CHECK_RECOVERY_THRESHOLD=2

# ─── Inbound connection hardening ───────────────────────────────────────────────
HEADER_READ_TIMEOUT_SECS=10
CONNECTION_IDLE_TIMEOUT_SECS=90
MAX_CONNECTIONS=900
# Behind Docker's userland proxy every client shares one peer IP — keep this high.
PER_IP_MAX_CONNECTIONS=5000

# ─── Upstream SSRF guard ────────────────────────────────────────────────────────
SSRF_BLOCK_METADATA=true
UPSTREAM_ALLOWLIST=
UPSTREAM_DENYLIST=

# ─── Geo-blocking (needs a MaxMind .mmdb; off in the demo) ──────────────────────
GEO_DB_PATH=

# ─── Downstream mTLS header names (only used behind a TLS-terminating proxy) ────
MTLS_VERIFY_HEADER=x-ssl-client-verify
MTLS_SUBJECT_HEADER=x-ssl-client-s-dn
MTLS_ISSUER_HEADER=x-ssl-client-i-dn
MTLS_VERIFY_SUCCESS_VALUE=SUCCESS

# ─── Licensing ──────────────────────────────────────────────────────────────────
# Nothing to configure for the free edition. To go to full capacity, upload the
# .lic file from System → License in the admin console (takes effect at once).
# Leave ORG_ID empty for an uploaded licence; set it only if you switch to a
# licence file mounted at APIGATEWAY_LICENSE_PATH.
ORG_ID=
# APIGATEWAY_LICENSE_PATH=/etc/apigateway/license.lic
LICENSE_NOTIFY_EMAILS=
